    id_produto,
    quantidade,
    valor_unitario
)
SELECT
    v.id_venda,
    p.id_produto,
    FLOOR(RANDOM() * 5 + 1)::INT,
    p.preco
FROM vendas v
CROSS JOIN LATERAL (
    SELECT id_produto, preco
    FROM produtos
    ORDER BY RANDOM()
    LIMIT 1 + FLOOR(RANDOM() * 3)::INT
) p;`

