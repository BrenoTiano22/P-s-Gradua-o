`INSERT INTO dim_tempo (
    id_tempo,
    data,
    dia,
    mes,
    nome_mes,
    trimestre,
    ano
)
SELECT
    TO_CHAR(dia_data, 'YYYYMMDD')::INTEGER,
    dia_data,
    EXTRACT(DAY FROM dia_data)::INTEGER,
    EXTRACT(MONTH FROM dia_data)::INTEGER,

    CASE EXTRACT(MONTH FROM dia_data)::INTEGER
        WHEN 1 THEN 'Janeiro'
        WHEN 2 THEN 'Fevereiro'
        WHEN 3 THEN 'Março'
        WHEN 4 THEN 'Abril'
        WHEN 5 THEN 'Maio'
        WHEN 6 THEN 'Junho'
        WHEN 7 THEN 'Julho'
        WHEN 8 THEN 'Agosto'
        WHEN 9 THEN 'Setembro'
        WHEN 10 THEN 'Outubro'
        WHEN 11 THEN 'Novembro'
        WHEN 12 THEN 'Dezembro'
    END,

    EXTRACT(QUARTER FROM dia_data)::INTEGER,
    EXTRACT(YEAR FROM dia_data)::INTEGER

FROM generate_series(
    DATE '2024-01-01',
    DATE '2026-12-31',
    INTERVAL '1 day'
) AS dias(dia_data);`

